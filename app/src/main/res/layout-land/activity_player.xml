<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/bg_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_dark"
                android:contentDescription="@string/back"
                android:padding="16dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLock"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:background="@drawable/bg_button_ghost"
                android:gravity="center"
                android:minWidth="100dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/lock"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_circle_accent"
            android:contentDescription="@string/stay"
            android:padding="32dp"
            android:src="@drawable/ic_pause" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/bg_scrim"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/timeCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="64dp"
                    android:text="@string/time_zero"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress_bar"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb" />

                <TextView
                    android:id="@+id/timeTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="64dp"
                    android:text="@string/time_zero"
                    android:textColor="@color/text"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSlow"
                    style="@style/PlayerButton"
                    android:layout_height="72dp"
                    android:text="@string/speed"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/btnRewind"
                    style="@style/PlayerButton"
                    android:layout_height="72dp"
                    android:text="@string/rewind"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/btnForward"
                    style="@style/PlayerButton"
                    android:layout_height="72dp"
                    android:text="@string/forward"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/btnSubtitle"
                    style="@style/PlayerButton"
                    android:layout_height="72dp"
                    android:text="@string/subtitles_on"
                    android:textSize="22sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnVolDown"
                    style="@style/PlayerButton"
                    android:layout_height="72dp"
                    android:text="@string/volume_down"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/btnVolUp"
                    style="@style/PlayerButton"
                    android:layout_height="72dp"
                    android:text="@string/volume_up"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/lockedHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_scrim"
        android:paddingStart="18dp"
        android:paddingTop="6dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp"
        android:text="@string/locked_hint"
        android:textColor="@color/text_dim"
        android:textSize="18sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="160dp"
        android:background="@drawable/bg_scrim"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text"
        android:textSize="30sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
