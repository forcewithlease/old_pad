<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ImageView
        android:id="@+id/photoImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/all_photos"
        android:scaleType="fitCenter" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:background="@drawable/bg_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_circle_dark"
            android:contentDescription="@string/back"
            android:padding="18dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/counter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <View
            android:layout_width="72dp"
            android:layout_height="72dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/bg_scrim"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/btnSlideshow"
            style="@style/PlayerButton"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_weight="0"
            android:background="@drawable/bg_button_accent"
            android:text="@string/slideshow"
            android:textColor="#12161C"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPrev"
                style="@style/PlayerButton"
                android:layout_height="92dp"
                android:text="@string/prev_photo"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/btnNext"
                style="@style/PlayerButton"
                android:layout_height="92dp"
                android:text="@string/next_photo"
                android:textSize="28sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
