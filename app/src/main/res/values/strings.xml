    <string name="settings_title">设置</string>
    <string name="auto_start">开机自动打开</string>
    <string name="auto_start_desc">开机后自动进入本应用。部分品牌还需要在系统设置里允许“自启动”。</string>
    <string name="launcher_mode">设为桌面</string>
    <string name="launcher_mode_desc">开机后直接进入本应用，代替系统桌面。适合专用平板。</string>
    <string name="keep_awake">播放时屏幕常亮</string>
    <string name="keep_awake_desc">看视频、看照片、玩游戏时都不自动黑屏。</string>
    <string name="subtitle_size">字幕大小</string>
    <string name="subtitle_size_desc">老人看不清字幕时，可以调大。</string>
    <string name="size_big">大</string>
    <string name="size_bigger">更大</string>
    <string name="size_biggest">最大</string>
    <string name="manage_home">管理首页格子</string>
    <string name="manage_home_desc">决定首页显示哪些内容、按什么顺序排。</string>
    <string name="video_folder_title">视频和照片放在哪里？</string>
    <string name="video_folder_desc">视频放在 Movies 文件夹，照片放在 Pictures 文件夹。一个文件夹就是一部电视剧或一组照片，例如“西游记”“孙女”。</string>
    <string name="rescan_videos">重新扫描视频和照片</string>
    <string name="open_system_settings">打开系统设置</string>
    <string name="ignore_battery">关闭电池优化</string>
    <string name="all_files_access">允许读取字幕文件（所有文件访问）</string>
    <string name="all_files_desc">Android 11 以上系统默认不允许读取视频旁边的 .srt/.ass 字幕。开启“所有文件访问”后字幕才能自动加载（可选）。</string>
    <string name="all_files_granted">已允许读取字幕文件</string>
    <string name="all_files_go">去开启</string>
    <string name="about_title">关于</string>
    <string name="about_desc">OldPad 是给家里老人用的离线视频、相册和棋牌小游戏。不联网、不上传，所有内容都在平板本地。</string>

    <string name="manage_title">管理首页格子</string>
    <string name="manage_hint">上箭头往前排，下箭头往后排；关掉开关就不在首页显示。首页最前面 3 格自动显示最近用过的内容。</string>
